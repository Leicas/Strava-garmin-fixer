# Public base URL where this service is reachable. Used for OAuth redirects
# and the Strava webhook callback URL. Must be HTTPS in production.
PUBLIC_BASE_URL=http://localhost:8000

# SQLite path. /data/state.db inside the container; ./data/state.db locally.
DATABASE_PATH=data/state.db

# Strava: register at https://www.strava.com/settings/api
# - Authorization Callback Domain: the host of PUBLIC_BASE_URL (e.g. localhost
#   or stravafit.example.com — no scheme, no port, no path)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional but strongly recommended once known: your Strava athlete id. If set,
# the webhook handler drops events from any other owner. (Strava webhook POSTs
# are not signed, so this is the strongest filter we have.)
# Find it under https://www.strava.com/settings/profile or in any activity URL.
# STRAVA_OWNER_ID=

# Google Health (replaces the deprecated Fitbit Web API):
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable the "Health API" (health.googleapis.com)
# 3. Create OAuth 2.0 credentials → application type: "Web application"
# 4. Authorized redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
# 5. Add yourself as a test user under OAuth consent screen → "Audience"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Garmin Connect (unofficial API — your own account credentials, no dev
# program, no subscription). Since Strava paywalled its API (June 2026),
# Garmin is the primary replace target: the merged FIT is uploaded here and
# Garmin's native sync pushes it on to Strava.
# If the account has MFA, run `stravafit garmin login` once interactively to
# seed the token cache (GARMIN_TOKENS_PATH); after that, logins are headless.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# GARMIN_TOKENS_PATH=data/garmin_tokens

# Poller: check Garmin for new activities every N minutes (replaces the
# Strava webhook as the automatic trigger). 0 disables.
# GARMIN_POLL_MINUTES=15
# GARMIN_POLL_MODE=auto          # dry_run | semi_auto | auto
# GARMIN_POLL_LOOKBACK_HOURS=48
# Leave fresh activities alone this long so the watch can sync HR to Google
# Health first; unmatched activities are then delivered to Dreeve as-is.
# GARMIN_POLL_MIN_AGE_MINUTES=120

# Dreeve hand-off: write the definitive FIT (merged, or original when no HR
# match) into DREEVE_EXPORT_DIR. When co-located with Dreeve, set the compose
# variable DREEVE_WATCH_DIR to Dreeve's watch folder so files land there
# directly. Turn the stock dreeve-garmin-connector's download loop OFF first:
# Dreeve dedups on (sport, start time), so whoever delivers first wins.
# DREEVE_EXPORT_ENABLED=1
# DREEVE_WATCH_DIR=/etc/komodo/stacks/strava-stats/watch

# Random string used in the Strava webhook handshake. Any non-empty value works.
# Pick something long and random.
VERIFY_TOKEN=change-me

# Dashboard HTTP Basic auth. REQUIRED on a publicly reachable host.
# Use a strong, unique password.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Local-dev escape hatch ONLY. NEVER set this on a public host.
# DASHBOARD_AUTH_DISABLED=1
